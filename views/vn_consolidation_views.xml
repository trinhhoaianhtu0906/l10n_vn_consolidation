<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vn_consolidation_group_view_list" model="ir.ui.view">
        <field name="name">vn.consolidation.group.list</field>
        <field name="model">vn.consolidation.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_company_id"/>
                <field name="goodwill_years" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="vn_consolidation_group_view_form" model="ir.ui.view">
        <field name="name">vn.consolidation.group.form</field>
        <field name="model">vn.consolidation.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_report" type="object" string="Lập báo cáo hợp nhất" class="btn-primary"/>
                    <button name="action_open_worksheet" type="object" string="Bảng tính loại trừ"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ví dụ: Tập đoàn ABC"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_company_id" options="{'no_create': True}"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="goodwill_years"/>
                            <field name="cit_rate"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thành viên" name="members">
                            <field name="member_ids">
                                <list>
                                    <field name="company_id"/>
                                    <field name="method"/>
                                    <field name="ownership_pct"/>
                                    <field name="acquisition_date"/>
                                    <field name="investment_cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="company_id" options="{'no_create': True}"/>
                                            <field name="method"/>
                                            <field name="ownership_pct"/>
                                        </group>
                                        <group>
                                            <field name="acquisition_date"/>
                                            <field name="investment_cost"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                    <separator string="Vốn chủ sở hữu tại ngày mua" invisible="method != 'full'"/>
                                    <div invisible="method != 'full'" class="text-muted mb-2">
                                        Để trống thì hệ thống tự lấy từ sổ của công ty con tại ngày mua.
                                        Bấm "Lấy số dư" để lưu lại, kiểm tra và điều chỉnh (ví dụ chênh lệch đánh giá lại theo giá trị hợp lý).
                                    </div>
                                    <button name="action_take_snapshot" type="object" string="Lấy số dư tại ngày mua"
                                            class="btn-secondary mb-2" invisible="method != 'full' or not id"/>
                                    <field name="snapshot_line_ids" invisible="method != 'full'">
                                        <list editable="bottom">
                                            <field name="code"/>
                                            <field name="amount" sum="Tổng"/>
                                            <field name="currency_id" column_invisible="1"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Lãi chưa thực hiện" name="unrealized">
                            <field name="unrealized_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="seller_company_id" options="{'no_create': True}"/>
                                    <field name="buyer_company_id" options="{'no_create': True}"/>
                                    <field name="kind"/>
                                    <field name="goods_value"/>
                                    <field name="margin_pct"/>
                                    <field name="amount"/>
                                    <field name="tax_rate"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bút toán điều chỉnh" name="adjustments">
                            <field name="adjustment_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                                </list>
                                <form>
                                    <header>
                                        <button name="action_confirm" type="object" string="Áp dụng" class="btn-primary" invisible="state == 'confirmed'"/>
                                        <button name="action_draft" type="object" string="Về nháp" invisible="state == 'draft'"/>
                                        <field name="state" widget="statusbar"/>
                                    </header>
                                    <group>
                                        <field name="name"/>
                                        <field name="date"/>
                                    </group>
                                    <field name="line_ids" readonly="state == 'confirmed'">
                                        <list editable="bottom">
                                            <field name="code"/>
                                            <field name="partner_id"/>
                                            <field name="debit" sum="Nợ"/>
                                            <field name="credit" sum="Có"/>
                                            <field name="currency_id" column_invisible="1"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vn_consolidation_group_action" model="ir.actions.act_window">
        <field name="name">Nhóm hợp nhất</field>
        <field name="res_model">vn.consolidation.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo nhóm hợp nhất đầu tiên</p>
            <p>Khai báo công ty mẹ, các công ty con và công ty liên kết, tỷ lệ lợi ích và ngày mua.</p>
        </field>
    </record>
</odoo>
