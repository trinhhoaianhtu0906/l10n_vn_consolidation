<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vn_consolidation_group_view_list" model="ir.ui.view">
        <field name="name">vn.consolidation.group.list</field>
        <field name="model">vn.consolidation.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_company_id"/>
                <field name="goodwill_years" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="vn_consolidation_group_view_form" model="ir.ui.view">
        <field name="name">vn.consolidation.group.form</field>
        <field name="model">vn.consolidation.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_report" type="object" string="Consolidated Statements" class="btn-primary"/>
                    <button name="action_open_worksheet" type="object" string="Elimination Worksheet"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. ABC Group"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_company_id" options="{'no_create': True}"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="goodwill_years"/>
                            <field name="cit_rate"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids">
                                <list>
                                    <field name="company_id"/>
                                    <field name="method"/>
                                    <field name="ownership_pct"/>
                                    <field name="acquisition_date"/>
                                    <field name="investment_cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="company_id" options="{'no_create': True}"/>
                                            <field name="method"/>
                                            <field name="ownership_pct"/>
                                        </group>
                                        <group>
                                            <field name="acquisition_date"/>
                                            <field name="investment_cost"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                    <separator string="Equity at Acquisition" invisible="method != 'full'"/>
                                    <div invisible="method != 'full'" class="text-muted mb-2">
                                        When empty, it is read from the subsidiary's ledger at the acquisition date.
                                        Click "Take Balances at Acquisition" to store it, review it and adjust it (e.g. fair value differences).
                                    </div>
                                    <button name="action_take_snapshot" type="object" string="Take Balances at Acquisition"
                                            class="btn-secondary mb-2" invisible="method != 'full' or not id"/>
                                    <field name="snapshot_line_ids" invisible="method != 'full'">
                                        <list editable="bottom">
                                            <field name="code"/>
                                            <field name="amount" sum="Total"/>
                                            <field name="currency_id" column_invisible="1"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Unrealised Profit" name="unrealized">
                            <field name="unrealized_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="seller_company_id" options="{'no_create': True}"/>
                                    <field name="buyer_company_id" options="{'no_create': True}"/>
                                    <field name="kind"/>
                                    <field name="goods_value"/>
                                    <field name="margin_pct"/>
                                    <field name="amount"/>
                                    <field name="tax_rate"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Adjustments" name="adjustments">
                            <field name="adjustment_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                                </list>
                                <form>
                                    <header>
                                        <button name="action_confirm" type="object" string="Apply" class="btn-primary" invisible="state == 'confirmed'"/>
                                        <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                                        <field name="state" widget="statusbar"/>
                                    </header>
                                    <group>
                                        <field name="name"/>
                                        <field name="date"/>
                                    </group>
                                    <field name="line_ids" readonly="state == 'confirmed'">
                                        <list editable="bottom">
                                            <field name="code"/>
                                            <field name="partner_id"/>
                                            <field name="debit" sum="Debit"/>
                                            <field name="credit" sum="Credit"/>
                                            <field name="currency_id" column_invisible="1"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Notes" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vn_consolidation_group_action" model="ir.actions.act_window">
        <field name="name">Consolidation Groups</field>
        <field name="res_model">vn.consolidation.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first consolidation group</p>
            <p>Set the parent company, the subsidiaries and associates, the ownership and the acquisition dates.</p>
        </field>
    </record>
</odoo>
